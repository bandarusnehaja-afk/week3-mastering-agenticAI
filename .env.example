# --- LLM (required for `chat`; optional for `report --narrative`) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Jira (optional — falls back to realistic mock data if unset) ---
JIRA_BASE_URL=https://yourteam.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=

# --- Asana (optional — falls back to realistic mock data if unset) ---
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

# --- Notion (optional — falls back to realistic mock data if unset) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Misc ---
PM_AGENT_DB_PATH=./data/memory.sqlite3
PM_AGENT_REPORTS_DIR=./reports
PM_AGENT_STALE_DAYS=7
